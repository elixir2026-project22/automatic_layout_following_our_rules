      <reaction compartment="compartment_5460" fast="false" id="reaction_77331" metaid="metaid_132" name="(S)-Hydroxyoctanoyl-CoA+NAD =&gt; 3-Oxooctanoyl-CoA+NADH+H" reversible="false">
